   "section": "container-light",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "The giant ELT dome will house the telescope and its interior structure, providing protection from the extreme environment of Chile’s Atacama Desert. The main structure of the telescope will hold its five mirrors and optics, including the enormous 39-metre primary mirror."
    }
   ],
